# Supabase project. Required for the contact form to save leads to the database (falls back to
# local JSON-line files when SUPABASE_SECRET_KEY is unset) and for /admin auth. The admin route
# returns 503 in production when the two NEXT_PUBLIC_ vars are unset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=change-me
# Server only. Never prefix with NEXT_PUBLIC_, never log it, never send it to the browser.
SUPABASE_SECRET_KEY=change-me

# Public site URL used for sitemap and canonical links
NEXT_PUBLIC_SITE_URL=https://example.com
